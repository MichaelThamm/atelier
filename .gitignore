.atelier/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
atelier-import.tfquery.hcl
atelier-import.auto.tfvars
/atelier
/atelier_dev
/gallerysite

# Local Terraform scratch and fixtures (e.g. a shared atelier.presets/ with
# wrappers beneath it). Keep out of the repo and out of agent search.
tf-testing/

# Local git worktrees. Each is a nested repository, so committing one would add
# a gitlink and break clones; `git worktree list` still finds them.
.worktrees/

# Python integration tests
.venv/
__pycache__/
*.pyc
.pytest_cache/

# GitHub Pages site: generated pages and the MkDocs build output. Every
# website page is generated from a source elsewhere in the repo, except the
# hand-written index.
website/docs/*.md
!website/docs/index.md
website/site/
